# ============================================
# WhatsApp Sales Agent - Environment Variables
# ============================================
# Copy this file to .env and fill in your real values
# cp .env.example .env
#
# Note: if any value is left empty, the project will
# automatically run in mock mode (no real API calls).

# --- Twilio ---
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# --- Groq (conversation logic - free and fast) ---
# Get this from: https://console.groq.com/keys
GROQ_API_KEY=

# --- General settings ---
APP_ENV=development
BASE_URL=http://localhost:8001